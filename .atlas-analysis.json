  "keyFeatures": [
    "Event-driven screen capture with accessibility tree extraction",
    "Local audio transcription with Whisper (speaker identification)",
    "AI-powered natural language search across screen and audio",
    "Visual timeline view of screen history",
    "Pipes system - scheduled AI agents as markdown files",
    "MCP server for AI assistant integration",
    "REST API and JavaScript/TypeScript SDK",
    "Cloud sync with end-to-end encryption",
    "Teams with central config and per-pipe data permissions",
    "Cross-platform - macOS, Windows, Linux"
  ],
  "publicApiSurface": [
    "GET /search - Search screen and audio content",
    "GET /frames - Retrieve screen captures",
    "GET /audio - Get audio transcriptions",
    "GET /pipes - List available pipes",
    "POST /pipes/run - Execute a pipe",
    "GET /health - Health check",
    "pipe.queryScreenpipe() - SDK search method",
    "pipe.sendDesktopNotification() - SDK notification",
    "screenpipe record - CLI recording command",
    "screenpipe pipe - CLI pipe management",
    "screenpipe sync - CLI cloud sync"
  ]
